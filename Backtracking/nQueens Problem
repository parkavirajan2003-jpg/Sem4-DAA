#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
int x[30]; 
int solution_count = 0;
bool place(int k, int i) {
    for (int j = 1; j <= k - 1; j++) {
        if ((x[j] == i) || (abs(x[j] - i) == abs(j - k))) {
            return false;
        }
    }
    return true;
}
void printSolution(int n) {
    solution_count++;
    printf("Solution %d: Set = [", solution_count);
    for (int i = 1; i <= n; i++) {
        printf("%d%s", x[i], (i == n ? "" : ", "));
    }
    printf("]\n");
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            if (x[i] == j) 
                printf(" Q "); 
            else 
                printf(" . "); 
        }
        printf("\n");
    }
    printf("---------------------------\n\n");
}
void nqueens(int k, int n) {
    for (int i = 1; i <= n; i++) {
        if (place(k, i)) {
            x[k] = i; 
            if (k == n) {
                printSolution(n);
            } else {
                nqueens(k + 1, n);
            }
        }
    }
}
int main() {
    int n;
    printf("Enter board size (e.g., 4 or 8): ");
    scanf("%d", &n);
    if (n < 1) {
        printf("Invalid board size.\n");
        return 1;
    }
    nqueens(1, n);
    if (solution_count == 0) {
        printf("No solutions exist for size %d.\n", n);
    } else {
        printf("Total solutions found: %d\n", solution_count);
    }
    return 0;
}
