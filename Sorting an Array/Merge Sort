#include<stdio.h>
void mergeSort(int a[],int l,int m,int r){
   int i=l,j=m+1,k=l;
   int b[100];
   while(i<=m && j<=r){
      if(a[i]<=a[j])
	 b[k++]=a[i++];
      else
	 b[k++]=a[j++];
   }
   while(i<=m)
      b[k++]=a[i++];
   while(j<=r)
      b[k++]=a[j++];
   for(i=l;i<=r;i++)
      a[i]=b[i];
}
void merge(int a[],int l,int r){
   int m;
   if(l<r){
      m=(l+r)/2;
      merge(a,l,m);
      merge(a,m+1,r);
      mergeSort(a,l,m,r);
   }
}
int main(){
   int a[100],n,i;
   printf("Enter the no.of elements:");
   scanf("%d",&n);
   printf("Enter elements:\n");
   for(i=0;i<n;i++)
      scanf("%d",&a[i]);
   merge(a,0,n-1);
   printf("Sorted Array:");
   for(i=0;i<n;i++)
      printf("%d ",a[i]);
   return 0;
}
